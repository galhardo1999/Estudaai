generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom properties from original PRD (made optional to support basic OAuth login)
  cpf           String?   @unique
  senha         String?
  role          String?   @default("USER")
  dataNascimento DateTime?
  telefone      String?
  genero        String?

  accounts      Account[]
  sessions      Session[]
  documentos    Documento[]
  pastas        Pasta[]
  exames        Exame[]
  resumos       Resumo[]
  tokenUsages   TokenUsage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pasta {
  id         String   @id @default(uuid())
  nome       String
  criadoEm   DateTime @default(now())
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Pasta?   @relation("PastaSubpastas", fields: [parentId], references: [id], onDelete: Cascade)
  subpastas  Pasta[]  @relation("PastaSubpastas")
  documentos Documento[]

  @@index([usuarioId])
}

model Documento {
  id        String   @id @default(uuid())
  titulo    String
  descricao String   @default("") // Descrição textual do documento (campo legado)
  mimeType  String   @default("application/pdf") // Tipo MIME do arquivo
  url       String   // Link para o Supabase Storage
  geminiUri String?  // URI do Google Gemini File Manager (para processamento IA)
  tamanho   Int?     // Tamanho do arquivo em bytes
  criadoEm  DateTime @default(now())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pastaId   String?
  pasta     Pasta?   @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  exames    Exame[]

  @@index([usuarioId])
}

model Exame {
  id              String   @id @default(uuid())
  codigo          String?  // Código curto legível (ex: A3F2)
  pontuacao       Int
  totalQuestoes   Int
  duracao         Int      // Tempo gasto em segundos
  dificuldade     String   @default("medio") // "facil" | "medio" | "dificil"
  status          String   @default("em_andamento") // "em_andamento" | "finalizado"
  questoes        Json?    // Estrutura das perguntas passadas
  respostas       Json?    // Mapeamento do id_da_questao -> id_da_opcao escolhida
  estadoAtual     Json?    // Estado parcial do exame para persistência (currentQuestionIndex, userAnswers, timeRemaining, etc.)
  criadoEm        DateTime @default(now())
  usuarioId       String
  usuario         User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  documentoId     String?
  documento       Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  nomesDocumentos String[] // Array de nomes dos documentos usados na geração

  @@index([usuarioId, criadoEm])
}

model Resumo {
  id          String   @id @default(uuid())
  tipo        String   // "resumo" | "flashcards"
  nomeArquivo String
  conteudo    String   @db.Text
  criadoEm   DateTime @default(now())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
}

model TokenUsage {
  id           String   @id @default(uuid())
  modelo       String   @default("gemini-2.5-flash")
  operation    String   // e.g. "generate_resumo", "generate_exame"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  criadoEm     DateTime @default(now())
  usuarioId    String?
  usuario      User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
}
