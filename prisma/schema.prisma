generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom properties from original PRD (made optional to support basic OAuth login)
  cpf           String?   @unique
  senha         String?
  dataNascimento DateTime?
  telefone      String?
  genero        String?

  accounts      Account[]
  sessions      Session[]
  documentos    Documento[]
  exames        Exame[]
  resumos       Resumo[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Documento {
  id        String   @id @default(uuid())
  titulo    String
  descricao String
  url       String   // Link para o Supabase Storage
  geminiUri String?  // URI do Google Gemini File Manager (para processamento IA)
  criadoEm  DateTime @default(now())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  exames    Exame[]
}

model Exame {
  id            String   @id @default(uuid())
  pontuacao     Int
  totalQuestoes Int
  duracao       Int      // Tempo gasto em segundos
  questoes      Json?    // Estrutura das perguntas passadas
  respostas     Json?    // Mapeamento do id_da_questao -> id_da_opcao escolhida
  criadoEm      DateTime @default(now())
  usuarioId     String
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  documentoId   String?
  documento     Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
}

model Resumo {
  id          String   @id @default(uuid())
  tipo        String   // "resumo" | "flashcards"
  nomeArquivo String
  conteudo    String   @db.Text
  criadoEm   DateTime @default(now())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
